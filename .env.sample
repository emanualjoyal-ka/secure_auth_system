PORT=5000

# DATABASE CONFIGURATION
MONGO_URI=mongodb://127.0.0.1:27017/your_database
MONGO_TEST_URI=mongodb://127.0.0.1:27017/your_test_database

NODE_ENV='development'

# Generate secure random secrets for JWT signing
JWT_ACCESS_SECRET=your_access_token_secret
JWT_REFRESH_SECRET=your_refresh_token_secret

# Token expiration durations
ACCESS_TOKEN_EXPIRE=5m
REFRESH_TOKEN_EXPIRE=7d

# Frontend application URL
CLIENT_URL="http://localhost:3000"

BACKEND_URL="http://localhost:5000"

# For Nodemailer to send emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password # Never use your regular Gmail account password. For Gmail, generate an App Password


APP_ENV='demo'

# Exposes verification/reset tokens in API responses ONLY
# Keep this false in production.
EXPOSE_DEV_TOKENS='true'